{
  "name": "dental-lab-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze:routes": "node scripts/bundle-route-baseline.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "prisma generate --schema=prisma/schema.prisma && node scripts/prisma-migrate-deploy.cjs && next build && node scripts/copy-standalone-assets.cjs && node scripts/verify-standalone-after-build.cjs",
    "build:platform": "prisma generate --schema=prisma/schema.prisma && next build && node scripts/copy-standalone-assets.cjs && node scripts/verify-standalone-after-build.cjs",
    "start:platform": "node scripts/start-production.cjs",
    "sync:saas": "node scripts/sync-saas-from-lab.cjs",
    "sync:saas:watch": "node scripts/watch-sync-saas.cjs",
    "sync:saas:install-hook": "node scripts/install-saas-sync-git-hook.cjs",
    "bootstrap:saas": "npm run sync:saas",
    "start": "node server.js",
    "start:next": "next start",
    "db:generate": "prisma generate",
    "db:generate:control": "prisma generate --schema prisma/control/schema.prisma",
    "db:generate:tenant": "prisma generate --schema prisma/tenant/schema.prisma",
    "db:generate:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prisma-clean-generate.ps1",
    "db:generate:clean:force": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prisma-clean-generate.ps1 -KillAllNode",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy:control": "prisma migrate deploy --schema prisma/control/schema.prisma",
    "db:migrate:deploy:tenant": "prisma migrate deploy --schema prisma/tenant/schema.prisma",
    "tenant:migrate:current": "node --env-file=.env scripts/tenant-migrate-current.cjs",
    "tenant:provision:db": "node --env-file=.env scripts/tenant-provision-db.cjs",
    "tenant:routing:rollback": "node --env-file=.env scripts/tenant-routing-rollback.cjs",
    "db:migrate:deploy": "node scripts/prisma-migrate-deploy.cjs",
    "db:migrate:resolve:attachment-disk": "prisma migrate resolve --applied 20260420190000_order_attachment_disk_rel_path",
    "db:backup": "node --env-file=.env scripts/db-backup.cjs",
    "db:migrate:sqlite-to-pg:dry-run": "node --env-file=.env scripts/migrate-sqlite-to-postgres.cjs --dry-run",
    "db:migrate:sqlite-to-pg": "node --env-file=.env scripts/migrate-sqlite-to-postgres.cjs",
    "db:migrate:sqlite-to-pg:force": "node --env-file=.env scripts/migrate-sqlite-to-postgres.cjs --force",
    "db:validate:sqlite-to-pg": "node --env-file=.env scripts/validate-postgres-migration.cjs",
    "attachments:migrate:s3:dry-run": "node --env-file=.env scripts/migrate-order-attachments-to-s3.cjs --dry-run",
    "attachments:migrate:s3": "node --env-file=.env scripts/migrate-order-attachments-to-s3.cjs",
    "db:push": "prisma db push",
    "db:fix-user-telegram-phone": "node --env-file=.env scripts/ensure-user-telegram-phone-sqlite.cjs",
    "db:sync": "prisma db push",
    "db:seed": "prisma db seed",
    "owner:set-password": "node --env-file=.env scripts/set-owner-password.cjs",
    "mail:rules:order:import": "node --env-file=.env scripts/import-order-digitaldemon-mail-rules.cjs",
    "mail:rules:order:apply": "node --env-file=.env scripts/apply-order-digitaldemon-mail-rules.cjs",
    "mail:rules:order:deploy": "node --env-file=.env scripts/deploy-order-digitaldemon-mail-rules.cjs",
    "db:contractors:export": "node --env-file=.env scripts/contractors-backup-restore.cjs export",
    "db:contractors:import": "node --env-file=.env scripts/contractors-backup-restore.cjs import",
    "db:price:export": "node --env-file=.env scripts/price-backup-restore.cjs export",
    "db:price:import": "node --env-file=.env scripts/price-backup-restore.cjs import",
    "demo:anonymize-dump": "node scripts/anonymize-crm-dump.cjs",
    "demo:apply-dump": "node scripts/apply-crm-dump-to-demo.cjs",
    "db:studio": "prisma studio",
    "import:clinics": "node --env-file=.env scripts/import-clinics-xlsx.cjs",
    "import:clinics:1": "node --env-file=.env scripts/import-clinics-xlsx.cjs data/imports/1.xlsx",
    "sync:clinics:billing": "node --env-file=.env scripts/import-clinics-xlsx.cjs data/imports/1.xlsx --billing-only",
    "sync:clinics:excel": "node --env-file=.env scripts/import-clinics-xlsx.cjs data/imports/1.xlsx --sync-clinic-excel",
    "import:doctors": "node --env-file=.env scripts/import-doctors-xlsx.cjs",
    "repair:doctor-import-merge": "node --env-file=.env scripts/repair-doctor-import-merged-clinics.cjs",
    "repair:swapped-clinic-fields": "node --env-file=.env scripts/repair-swapped-clinic-fields.cjs",
    "import:clinics-pdf": "node --env-file=.env scripts/import-clinics-pdf.cjs",
    "import:price": "node --env-file=.env scripts/import-price-xlsx.cjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-standalone-windows.ps1",
    "package:windows:empty": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-standalone-windows.ps1 -SkipBundledDatabase",
    "package:server-tar": "bash scripts/package-server-archive.sh",
    "package:server-tar:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-server-archive.ps1",
    "package:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-server-archive.ps1",
    "kaiten:dump-boards": "node --env-file=.env scripts/kaiten-dump-board-columns.cjs",
    "contract:test": "node --env-file=.env scripts/generate-test-contract.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans": "^5.2.10",
    "@napi-rs/canvas": "^0.1.99",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.4.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/extension-font-family": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.172.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "expr-eval": "^2.0.2",
    "framer-motion": "^11.18.2",
    "imapflow": "^1.3.3",
    "jose": "^6.2.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mailparser": "^3.9.8",
    "next": "^15.2.4",
    "nodemailer": "^6.10.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.172.0",
    "three-mesh-bvh": "^0.9.10",
    "typescript": "^5.8.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "chokidar": "^4.0.3",
    "pino-pretty": "^13.1.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-linux-x64-gnu": "^0.1.99"
  },
  "overrides": {
    "rimraf": "^3.0.2"
  },
  "engines": {
    "node": ">=20.16.0"
  }
}
