generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-control"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum UserRole {
  ADMINISTRATOR
  SENIOR_ADMINISTRATOR
  SENIOR_TECHNICIAN
  PRODUCTION
  SENIOR_PRODUCTION
  MANAGER
  ACCOUNTANT
  FINANCIAL_MANAGER
  USER
  OWNER
}

enum UserDeviceType {
  DESKTOP
  MOBILE
}

enum AppModule {
  ORDERS
  ORDERS_CREATE
  KANBAN
  KANBAN_EDIT_TITLE
  KANBAN_EDIT_DUE_DATE
  KANBAN_EDIT_TRACK
  KANBAN_MANAGE_ASSIGNEES
  KANBAN_MANAGE_PARTICIPANTS
  KANBAN_MOVE_TO_OTHER_BOARD
  KANBAN_MANAGE_CHECKLIST
  KANBAN_MANAGE_TIMER
  ORDER_HISTORY
  ANALYTICS
  SIDEBAR_PAYMENTS
  PAYROLL
  SHIPMENTS
  WAREHOUSE
  CLIENTS
  CLIENTS_VIEW
  CLIENTS_EDIT
  DIRECTORY
  CONFIG_PRICING
  CONFIG_PRICING_CORRECTION
  CONFIG_WAREHOUSE
  CONFIG_KANBAN_BOARDS
  CONFIG_KANBAN_PRODUCTION
  CONFIG_KANBAN_CARD_TYPES
  CONFIG_KAITEN
  CONFIG_COURIERS
  CONFIG_ORDERS_IMPORT_EXPORT
  CONFIG_CONTRACT_TEMPLATE
  CONFIG_COSTING
  CONFIG_USERS
  CONFIG_USER_INVITES
}

model Tenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String?
  tenantDatabaseUrl     String?
  tenantDatabaseEnabled Boolean  @default(false)
  tenantDatabaseReadyAt DateTime?
  createdAt             DateTime @default(now())
}

model User {
  id          String   @id @default(cuid())
  tenantId    String
  email       String
  displayName String
  role        UserRole
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserDeviceSession {
  id         String         @id
  userId     String
  tenantId   String
  deviceType UserDeviceType
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, deviceType, revokedAt, expiresAt])
  @@index([tenantId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model RoleModuleAccess {
  id        String    @id @default(cuid())
  tenantId  String
  role      UserRole
  module    AppModule
  allowed   Boolean
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, role, module])
  @@index([tenantId, role])
}
