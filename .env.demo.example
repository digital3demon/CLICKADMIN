# Env для отдельного инстанса demo.click-lab.online
# НЕ копировать DATABASE_URL / KAITEN_* / Telegram-секреты с прода.

CRM_STANDALONE_DEMO=1
NEXT_PUBLIC_CRM_STANDALONE_DEMO=1

# Демо-данные — файл в хранилище (не общая БД с продом):
#   data/crm-dumps/demo/current.anonymized.zip
#   или S3: crm-dumps/demo/current.anonymized.zip
# CRM_DUMP_DIR=data/crm-dumps

# Если демо-процессу всё же нужна своя БД — только отдельный инстанс/файл,
# никогда не тот же DATABASE_URL, что у click-lab.online.
# DATABASE_URL=

AUTH_SECRET="replace-with-long-random-demo-secret-min-16"

# Где лежат одноразовые коды входа (таблица DemoAccessCode) — Postgres рабочей CRM.
# Без этого demo-хост не сможет проверить код из Конфигурации → «Доступ к демо».
# DEMO_ACCESS_DATABASE_URL=postgresql://...

CRM_PUBLIC_BASE_URL=https://demo.click-lab.online
NEXT_PUBLIC_APP_URL=https://demo.click-lab.online

# Kaiten / Telegram / mail — пусто
# KAITEN_API_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Тот же S3, что для дампов (если демо читает current из бакета)
# S3_ENABLED=true
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
